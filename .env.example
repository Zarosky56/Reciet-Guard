# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Providers
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# Gmail API
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=receiptguardbeta@gmail.com

# Optional Google Pub/Sub - later only, not required for MVP manual Gmail check
GOOGLE_CLOUD_PROJECT_ID=
GMAIL_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Optional Document AI premium tier (uses Google Cloud trial credits).
# Leave ENABLE_DOCUMENT_AI unset/false to skip and use Gemini → Groq fallback only.
# See .kiro/steering/cost-rules.md for billing safeguards.
ENABLE_DOCUMENT_AI=false
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_LOCATION=us
GCS_BUCKET_NAME=

# Optional Vertex AI Gemini (uses Google Cloud trial credits).
# Provides much larger Gemini quota than the AI Studio free tier.
ENABLE_VERTEX_AI=false
VERTEX_AI_LOCATION=us-central1

# Workload Identity Federation for Vercel → Google Cloud (no JSON keys needed).
# Set both on Vercel; locally use `gcloud auth application-default login`.
GCP_WIF_AUDIENCE=
GCP_WIF_SERVICE_ACCOUNT=

# Notifications
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# App
APP_URL=http://localhost:3000
WEBHOOK_SECRET=
CRON_SECRET=

# Optional Monitoring
SENTRY_DSN=
